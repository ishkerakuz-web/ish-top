# Backend manzili. Maxfiy emas — brauzerga ham ketadi.
# Prodda Railway bergan domen, masalan:
#   VITE_API_URL="https://ishbor-api.up.railway.app"
# Oxirida "/" bo'lmasin.
VITE_API_URL="http://localhost:3000"

# Saytning o'z ommaviy manzili. canonical, hreflang va og:url shundan quriladi.
# Prodda Vercel domeni yoki o'z domeningiz:
#   VITE_SITE_URL="https://ishbor.uz"
# MUHIM: bu qiymat noto'g'ri bo'lsa har sahifaning canonical'i boshqa saytga
# ishora qiladi va Google haqiqiy saytni indeksga olmaydi.
VITE_SITE_URL="http://localhost:5173"

# Yuklangan rasmlar (logo, maqola muqovasi) tashqi xotiradan berilsa — o'sha manzil.
# API dagi S3_PUBLIC_BASE_URL bilan AYNAN bir xil qiymat, masalan:
#   VITE_MEDIA_URL="https://pub-xxxxxxxx.r2.dev"
# Faqat CSP uchun kerak (img-src): berilmasa brauzer o'sha rasmlarni bloklaydi.
# API S3'siz (lokal disk) ishlayotgan bo'lsa bo'sh qoldiring.
VITE_MEDIA_URL=""

# Google orqali kirish (ixtiyoriy).
# apps/api dagi GOOGLE_CLIENT_ID bilan bir xil qiymat.
# Bo'sh bo'lsa — Google tugmasi ko'rinmaydi, sayt oddiy ishlayveradi.
VITE_GOOGLE_CLIENT_ID=""

# Eslatma: brauzer push xabarnomalari uchun VAPID ochiq kaliti bu yerda kerak
# emas — sayt uni ishga tushganda /api/push/public-key orqali oladi.
#
# Vercel'da bu o'zgaruvchilarni Environment Variables ga qo'shing.
# VITE_API_URL ikki joyda ishlatiladi:
#   1) build paytida — brauzerga ketadigan kodga yoziladi;
#   2) ishlash paytida — api/seo.js (robots.txt / sitemap proxy) o'qiydi.
