# ============================================================
# ISH BOR! — backend sozlamalari
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring.
# Bo'sh qoldirilgan ixtiyoriy bo'limlar shunchaki o'chiq turadi —
# sayt ularsiz ham to'liq ishlaydi.
#
# Railway'da bu qiymatlar Variables bo'limiga kiritiladi (fayl kerak emas).
# ============================================================

# --- Majburiy ---
# MongoDB ulanish satri. Atlas: Database -> Connect -> Drivers -> Node.js.
# Oxiridagi baza nomini o'zingiz yozing (misolda `ishbor`).
# MUHIM: Prisma tranzaksiyalari uchun replica set kerak — Atlas'da u sukut
# bo'yicha yoqilgan, mahalliy bitta `mongod` da esa yo'q (`--replSet` bilan
# ishga tushiring yoki Atlas'ning bepul M0 klasteridan foydalaning).
DATABASE_URL="mongodb+srv://user:parol@cluster0.xxxxx.mongodb.net/ishbor?retryWrites=true&w=majority"
# production'da har biri KAMIDA 32 belgi va bir-biridan farqli bo'lishi shart (aks holda server ishga tushmaydi).
# Quyidagi misol qiymatlar production'da RAD ETILADI — o'zingiz tasodifiy satr yarating.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="kamida-32-belgili-tasodifiy-satr-shu-yerga-yozing"
JWT_REFRESH_SECRET="boshqa-kamida-32-belgili-tasodifiy-satr-yozing"

# --- Asosiy ---
# Railway'da `production` bo'lishi SHART: seans cookie'si SameSite=None; Secure bo'ladi va
# JWT sirlari uzunligi tekshiriladi. Lokal ishlab chiqishda: development.
NODE_ENV=development
# PORT ni Railway o'zi beradi — prodda qo'lda yozmang.
PORT=3000
# Saytning ommaviy manzili (Vercel domeni yoki o'z domeningiz).
# CORS shu bo'yicha ochiladi, xat/Telegram havolalari ham shundan quriladi.
WEB_ORIGIN="http://localhost:5173"
# CORS uchun qo'shimcha manzillar, vergul bilan. Masalan o'z domeningiz:
# CORS_EXTRA_ORIGINS="https://ishbor.uz,https://www.ishbor.uz"
CORS_EXTRA_ORIGINS=""
# Vercel preview domenlari endi avtomatik ruxsat OLMAYDI (begona *.vercel.app sayti seans cookie'si bilan
# token olishi mumkin edi). Kerak bo'lsa faqat o'z preview'laringiz uchun aniq regex (to'liq moslik):
# CORS_PREVIEW_ORIGIN_REGEX="https://ishbor-[a-z0-9-]+-myteam\.vercel\.app"
CORS_PREVIEW_ORIGIN_REGEX=""
# Yuklangan fayllar (logotip, PDF rezyume) papkasi.
# Railway'da konteyner diski VAQTINCHALIK — har deployda tozalanadi. Prodda
# Volume ulab, uning Mount path'ini shu yerga yozing (masalan /data/uploads).
# Bo'sh qolsa loyiha papkasidagi `uploads/` ishlatiladi (faqat dev uchun).
UPLOAD_DIR=""

# Bitta IP uchun daqiqadagi so'rov chegarasi (BRAUZER so'rovlari uchun).
RATE_LIMIT_MAX=600

# --- Redis (IXTIYORIY) ---------------------------------------------------------
# Bo'sh bo'lsa hammasi jarayon xotirasida ishlaydi va sayt to'liq ishlayveradi —
# dev uchun Redis o'rnatish SHART EMAS. Qiymat berilsa quyidagilar API nusxalari
# orasida UMUMIY bo'ladi va API'ni bir nechta nusxada ishlatish mumkin bo'ladi:
#   - ko'rishlar buferi va "bu odam allaqachon ko'rgan" filtri
#   - kvotalar (SMS, ro'yxatdan o'tish, chat) va rate-limit
#   - kesh yangilanishi (bir nusxadagi tahrir hammasiga bildiriladi)
#   - WebSocket xabarlari va "onlayn" holati
#   - Telegram long-polling va obuna xabarnomalari uchun yagona nusxa qulfi
# DIQQAT: manzilni yozib qo'yib, Redis'ni ishga tushirmaslik ham xavfsiz — kod
# xotiradagi zaxira yo'lga tushadi (lekin loglarda ogohlantirish chiqadi).
REDIS_URL=""
# Bitta Redis'ni bir nechta muhit baham ko'rsa kalitlar aralashmasin
REDIS_PREFIX="ishbor:"

# Ko'rishlar hisoblagichi (audit: views-1). Ko'rishlar darhol emas, buferda yig'ilib
# shu oraliqda BITTA bulk yozuv bilan bazaga tushadi. Kichik qiymat — aniqroq son,
# ko'proq yozuv; katta qiymat — kamroq yozuv, sahifada kechikkan son.
VIEW_FLUSH_MS=30000
# Bitta ko'ruvchi bitta e'lonni shu muddat ichida qayta ochsa, ko'rish qayta sanalmaydi.
VIEW_DEDUPE_SEC=86400

# Foydalanuvchi holati (rol, blok, seans, telefon tasdig'i) keshi — har bir avtorizatsiyalangan
# so'rovdagi baza o'qishini olib tashlaydi. Bloklash, rol o'zgarishi va telefon tasdig'i keshni
# DARHOL bekor qiladi (Redis bo'lsa — barcha nusxalarda), shuning uchun bu muddat faqat bazada
# QO'LDA qilingan o'zgarish uchun ahamiyatli. 0 — kesh o'chiq.
AUTH_CACHE_MS=10000

# --- Fayl xotirasi: S3-mos (IXTIYORIY) ------------------------------------------
# Bo'sh bo'lsa fayllar yuqoridagi UPLOAD_DIR papkasiga yoziladi (dev uchun shunday qulay).
# To'ldirilsa fayllar platformaga bog'liq bo'lmaydi: Railway'da Volume kerak emas, bir nechta
# nusxa bir xil fayllarni ko'radi, konteyner diski tozalansa ham fayllar joyida qoladi.
# Uchtasi BIRGALIKDA berilishi shart, aks holda server ishga tushmaydi (yarim sozlanmasin).
# Cloudflare R2 misoli:
#   S3_BUCKET="ishbor"
#   S3_ACCESS_KEY_ID="..."
#   S3_SECRET_ACCESS_KEY="..."
#   S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS S3 uchun bo'sh qoldiring (SDK o'zi topadi); R2/MinIO uchun to'ldiring.
S3_ENDPOINT=""
S3_REGION="auto"
# Kalit prefiksi (papka). Bitta bucket'ni prod va staging baham ko'rsa — farqli qiymat bering.
S3_PREFIX="uploads/"
# Ochiq fayllar (logo, maqola muqovasi) shu manzildan beriladi — bucket'ning ochiq havolasi yoki CDN.
# Masalan R2: "https://pub-xxxxxxxx.r2.dev". AYNAN shu qiymatni saytga VITE_MEDIA_URL sifatida ham
# qo'ying (CSP uchun). Bo'sh qoldirilsa fayllar API orqali beriladi — ishlaydi, lekin sekinroq.
S3_PUBLIC_BASE_URL=""

# SSR (sayt serveri) so'rovlari uchun alohida, kengroq rate-limit bucket'i (audit R3, D-074).
# Barcha SSR so'rovlari Vercel'ning bir nechta UMUMIY IP'sidan keladi va brauzerlar bilan bitta
# bucket'da edi: katta crawl yoki oddiy trafik 429 berardi. Kalit KAMIDA 32 belgi bo'lsin va
# AYNAN shu qiymat saytning server muhitiga ham SSR_API_KEY sifatida qo'yilsin (VITE_ EMAS:
# VITE_ bilan boshlanadigan qiymat brauzer kodiga tushadi). Bo'sh bo'lsa imkoniyat o'chiq.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSR_API_KEY=""

# Reverse proxy ortida mijoz IP'si X-Forwarded-For'dan olinadi. Sukut endi "1" (bitta hop),
# audit R3, D-053. "true" bilan mijozning O'ZI yozgan X-Forwarded-For qiymati olinardi va IP
# bo'yicha har qanday limit (login, ariza, tiklash) soxta sarlavha bilan chetlab o'tilardi.
# Railway va bitta nginx/caddy uchun "1" to'g'ri; Cloudflare + Railway kabi ikki proxy uchun "2".
# Deploydan keyin TEKSHIRING: log'dagi so'rov remoteAddress qiymati X-Real-IP bilan bir xil
# bo'lishi kerak (amaldagi qiymat startupda "TRUST_PROXY = ..." qatorida yoziladi).
TRUST_PROXY=1

# --- Birinchi admin hisobi -------------------------------------------------
# Server ko'tarilganda shu email bilan admin YARATILADI, faqat bunday hisob umuman
# bo'lmasa (audit R3, D-069: mavjud hisob endi avtomatik admin qilinmaydi).
# Parol qayta yozilmaydi.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Telegram bot ----------------------------------------------------------
# PRODUCTION'DA MAJBURIY (audit R3, D-072). Telegram telefon tasdiqlash va parol tiklashning
# YAGONA kanali: usiz ariza yuborish, vakansiya joylash, chat, sharh va nomzodlar bazasi
# ochilmaydi, parolni ham tiklab bo'lmaydi. Telegram orqali KIRISH (login) endi yo'q.
# Token bo'lmasa server ishga tushadi, lekin startupda ogohlantiradi va UI "Telegram orqali
# tasdiqlash hozircha mavjud emas" deydi.
# @BotFather dan token oling.
# DIQQAT: bot long-polling ishlatadi, shuning uchun API xizmati faqat BITTA
# nusxada (replica) ishlashi kerak, aks holda Telegram 409 xatosi beradi.
TELEGRAM_BOT_TOKEN=""
# Support xabarlari boradigan chat. Botga /myid yozib bilib olasiz.
TELEGRAM_ADMIN_CHAT_ID=""

# --- Aloqa kanallari (/contact sahifasi) -----------------------------------
# Faqat HAQIQIY qiymatlarni yozing. Bo'sh qolganlari sahifada umuman chiqmaydi.
# Aloqa formasi TELEGRAM_BOT_TOKEN + TELEGRAM_ADMIN_CHAT_ID bilan ishlaydi.
SUPPORT_EMAIL=""
# Support Telegram akkaunti (masalan ishbor_support). Bo'sh bo'lsa — botning o'zi ko'rsatiladi.
SUPPORT_TELEGRAM=""
SUPPORT_PHONE=""
SUPPORT_ADDRESS=""
# Ish vaqti, masalan "Du–Ju, 09:00–18:00"
SUPPORT_HOURS=""
# Haqiqiy javob muddati soatda (masalan 24). Bo'sh bo'lsa va'da yozilmaydi.
SUPPORT_RESPONSE_HOURS=""
PARTNERSHIP_EMAIL=""

# --- Google orqali kirish --------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth Client ID (Web).
# Xuddi shu qiymat apps/web dagi VITE_GOOGLE_CLIENT_ID ga ham qo'yiladi.
# Authorized JavaScript origins ga saytning Vercel domenini qo'shishni unutmang.
GOOGLE_CLIENT_ID=""

# --- Email (SMTP) ----------------------------------------------------------
# Ariza, holat o'zgarishi va obuna xabarnomalari uchun.
# SMTP_HOST bo'sh bo'lsa xatlar yuborilmaydi (konsolga yoziladi).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ISH BOR! <no-reply@example.uz>"

# --- Brauzer push xabarnomalari (VAPID) ------------------------------------
# Kalit juftini yaratish:  npm run push:keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.uz"

# --- Meilisearch (ixtiyoriy) -----------------------------------------------
# Bo'sh bo'lsa qidiruv MongoDB orqali ishlaydi (qo'shimcha xizmat kerak emas).
MEILI_HOST=""
MEILI_API_KEY=""
MEILI_INDEX="vacancies"

# --- Monetizatsiya — HOZIRCHA O'CHIQ (platforma bepul) ----------------------
# Tariflar, checkout va to'lov webhook'lari faqat BILLING_ENABLED=true bo'lsa ro'yxatdan o'tadi.
BILLING_ENABLED=false
# To'lov provayderlari (faqat BILLING_ENABLED=true bo'lganda ishlatiladi):
PAYME_MERCHANT_ID=""
PAYME_KEY=""
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# --- Obuna xabarnomalari ---------------------------------------------------
# Saqlangan qidiruvlar necha daqiqada bir tekshirilsin.
ALERTS_INTERVAL_MINUTES=15

# --- Moderatsiya ------------------------------------------------------------
# Moderatsiyadagi vakansiya/sharh admin shu soat ichida ko'rmasa avtomatik tasdiqlanadi (0 — o'chiq).
MODERATION_AUTO_APPROVE_HOURS=24
# Yangi vakansiya moderatsiyaga tushadimi: unverified (tasdiqlanmagan kompaniyalar) | all | off
VACANCY_PREMODERATION=unverified
# Yangi sharhlar avval moderatsiyaga tushadimi (true/false)
REVIEW_PREMODERATION=true
