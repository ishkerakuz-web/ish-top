{
  "name": "api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma db push --skip-generate",
    "dev": "nodemon",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:sync": "prisma db push --skip-generate",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:auth": "node scripts/auth-telegram-check.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx src/prisma/seed.ts",
    "seed:demo": "tsx src/prisma/demo-seed.ts",
    "push:keys": "node scripts/generate-vapid.mjs",
    "alerts:run": "tsx src/scripts/run-alerts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@prisma/client": "^5.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "argon2": "^0.40.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.60.0",
    "nodemailer": "^9.0.5",
    "prisma": "^5.20.0",
    "satori": "^0.26.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
